{
  "name": "node-dep-resolver",
  "version": "1.1.6",
  "description": "A lightweight CLI tool & library to build dependency graphs and resolve semver conflicts.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "dep-resolver": "bin/cli.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "bin"
  ],
  "scripts": {
    "test": "node scripts/test_runner.js",
    "test:unit": "node scripts/test_runner.js --unit",
    "test:e2e": "node scripts/test_runner.js --e2e",
    "start": "node bin/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/unknownsideofme/dependency-resolver.git"
  },
  "homepage": "https://node-dep-resolver.devs.surf/",
  "keywords": [
    "cli",
    "dependency-resolver",
    "semver",
    "dependency-graph",
    "conflict-resolution",
    "backtracking"
  ],
  "author": "debanjan",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.0",
    "semver": "^7.6.0"
  }
}
